<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: violet splash in both light and dark system modes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ system splash: violet everywhere, adaptive logo icon. -->
        <item name="android:windowSplashScreenBackground">@color/sampan_violet</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/sampan_violet</item>
    </style>
    <!-- Theme applied once Flutter draws its first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
